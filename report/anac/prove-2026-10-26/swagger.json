          "name" : "filterField",
          "in" : "query",
          "description" : "The field to filter tenders count by",
          "required" : false,
          "type" : "string",
          "example" : "tenderStartDate",
          "enum" : [ "tenderStartDate" ],
          "default" : "tenderStartDate"
        }, {
          "name" : "filterArgs",
          "in" : "query",
          "description" : "The arguments of the filter",
          "required" : false,
          "type" : "array",
          "items" : {
            "type" : "string"
          },
          "example" : "2020-02-01,2020-02-28",
          "default" : "2020-02-01,2020-02-28"
        }, {
          "name" : "tenderStatus",
          "in" : "query",
          "description" : "The status of the tender to be counted",
          "required" : false,
          "type" : "string",
          "example" : "OPEN",
          "enum" : [ "OPEN", "CLOSED" ],
          "default" : "OPEN"
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "the max number of tender identifiers returned by the service",
          "required" : false,
          "type" : "string"
        }, {
          "name" : "offset",
          "in" : "query",
          "description" : "The number of identifierd to start returing identifiers from",
          "required" : false,
          "type" : "string"
        } ],
