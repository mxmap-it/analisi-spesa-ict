        "description" : "Return all the available awards given the search criteria",
        "parameters" : [ {
          "name" : "beginDate",
          "in" : "query",
          "description" : "the begin date of the search window (format 'YYYY-MM-DD')",
          "required" : false,
          "type" : "string",
          "format" : "date",
          "pattern" : '^\d{4}\-(0[1-9]|1[012])\-(0[1-9]|[12][0-9]|3[01])$',
          "example" : "2020-01-01",
          "default" : "2020-01-01"
        }, {
          "name" : "endDate",
          "in" : "query",
          "description" : "the end date of the search window (format 'YYYY-MM-DD')",
          "required" : false,
          "type" : "string",
          "format" : "date",
          "pattern" : '^\d{4}\-(0[1-9]|1[012])\-(0[1-9]|[12][0-9]|3[01])$',
          "example" : "2020-03-31",
          "default" : "2020-03-31"
        }, {
          "name" : "bottomAmount",
          "in" : "query",
          "description" : "the minimun amount of the returned awards",
          "required" : false,
          "type" : "string",
          "example" : "100000",
          "default" : "100000"
        }, {
          "name" : "topAmount",
          "in" : "query",
          "description" : "the maximum amount of the returned awards",
          "required" : false,
          "type" : "string",
          "example" : "200000",
          "default" : "200000"
        } ],
        "produces" : [ "application/json" ],
