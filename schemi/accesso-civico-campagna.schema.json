{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spesaict.accesso-civico-campagna/1",
  "title": "Campagna di accesso civico generalizzato (#58)",
  "description": "Insieme di richieste con scopo, perimetro, criteri, parametri e modelli comuni (specifica § 3.2). File config/accesso-civico/campagne/<id>.json; caricato e controllato da tools/accesso_civico/campagna.py. Stato oltre «proposta» solo con decisione di Fabio in DECISIONI.md.",
  "type": "object",
  "required": ["formato", "id", "titolo", "scopo", "progetto", "responsabile", "perimetro", "selezione", "parametri",
               "modelli", "template", "licenza_dati", "stato", "creata"],
  "properties": {
    "formato": {"const": "spesaict.accesso-civico-campagna/1"},
    "id": {"type": "string", "pattern": "^cmp-[0-9a-z-]+$", "description": "stabile, compare nell'URL pubblico"},
    "versione": {"type": "string"},
    "titolo": {"type": "string"},
    "scopo": {"type": "string", "description": "scopo dichiarato in pubblico (anche se non scritto nell'istanza, § 8.3)"},
    "progetto": {"type": "object", "required": ["nome"], "properties": {"nome": {"type": "string"}, "url": {"type": "string"}, "issue": {"type": "string"}}},
    "responsabile": {"type": "object", "required": ["nome"], "properties": {"nome": {"type": "string"}, "ruolo": {"type": "string"}}},
    "richiedente_id": {"type": ["string", "null"], "description": "riferimento al registro PRIVATO del richiedente (§ 9); in pubblico solo il nome"},
    "perimetro": {"type": "object", "properties": {"enti": {"type": "string"}, "documenti": {"type": "string"}, "periodo": {"type": "string"}}},
    "criteri": {"type": "array", "items": {"type": "string"}},
    "selezione": {"type": "object", "properties": {"sorgente": {"type": "string"}, "sorgente_sha256": {"type": ["string", "null"]},
                                                  "filtri": {"type": "array", "items": {"type": "string"}},
                                                  "ordine": {"type": "string"}, "comando": {"type": "string"}}},
    "parametri": {"type": "object", "properties": {"tetto_voci": {"type": "integer", "minimum": 1}, "max_enti_ondata": {"type": "integer"},
                                                  "cadenza_giorni": {"type": "integer"}, "tetto_pec_giorno": {"type": "integer"},
                                                  "intervallo_secondi": {"type": "integer"}, "sollecito_dopo": {"type": "integer"}}},
    "modelli": {"type": "object", "required": ["istanza"],
                "additionalProperties": {"type": "object", "required": ["path", "sha256", "versione"],
                                         "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                                                        "versione": {"type": "string"}}}},
    "template": {"type": "object", "description": "opzioni § 8.1: scopo_nell_istanza, link_pubblico, allegati, pec_richiedente_pubblica"},
    "ondate": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string"}, "enti": {"type": "integer"},
                                                                           "approvazione": {"type": ["object", "null"]}}}},
    "licenza_dati": {"type": "string"},
    "stato": {"enum": ["proposta", "approvata", "attiva", "in-pausa", "chiusa"]},
    "creata": {"type": "string", "format": "date"},
    "approvata": {"type": ["object", "null"], "properties": {"decisione": {"type": "string", "description": "riferimento a DECISIONI.md"}, "data": {"type": "string"}}},
    "note": {"type": "string"}
  }
}
